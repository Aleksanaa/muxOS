[host_machine]
system = 'muxos'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'

[binaries]
c = 'i686-unknown-linux-gnu-gcc'
cpp = 'i686-unknown-linux-gnu-g++'
ar = 'i686-unknown-linux-gnu-ar'
strip = 'i686-unknown-linux-gnu-strip'
ld = 'i686-unknown-linux-gnu-ld'
nm = 'i686-unknown-linux-gnu-nm'
objcopy = 'i686-unknown-linux-gnu-objcopy'

[properties]
needs_exe_wrapper = true
